extends SceneTree
const META = preload("res://scripts/audio/AudioMetadata.gd")
var failures := 0
func _initialize() -> void: run.call_deferred()
func check(ok: bool, message: String) -> void:
	print("PASS: " if ok else "FAIL: ", message)
	if not ok: failures += 1
func u32(value: int) -> PackedByteArray:
	var bytes := PackedByteArray()
	bytes.resize(4)
	bytes.encode_u32(0, value)
	return bytes
func write(path: String, bytes: PackedByteArray) -> void:
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_buffer(bytes)
func run() -> void:
	await process_frame
	var image := Image.create(4, 4, false, Image.FORMAT_RGB8)
	image.fill(Color.RED)
	var art := image.save_png_to_buffer()
	var apic := PackedByteArray([3])
	apic.append_array("image/png".to_ascii_buffer())
	apic.append_array(PackedByteArray([0, 3, 0]))
	apic.append_array(art)
	var body := "APIC".to_ascii_buffer()
	for shift in [21, 14, 7, 0]: body.append((apic.size() >> shift) & 127)
	body.append_array(PackedByteArray([0, 0]))
	body.append_array(apic)
	var tag := PackedByteArray([73, 68, 51, 4, 0, 0])
	for shift in [21, 14, 7, 0]: tag.append((body.size() >> shift) & 127)
	tag.append_array(body)
	write("res://.godot/cover-test.mp3", tag)
	var result := META.read_track("res://.godot/cover-test.mp3")
	check(result.cover is Texture2D and result.cover.get_width() == 4, "ID3 APIC PNG cover decodes")
	check(META.read_track("res://.godot/cover-test.mp3", false).cover == null, "Playlist metadata avoids allocating cover textures")
	check(META._text(PackedByteArray([1, 255, 254, 65, 0, 66, 0, 0, 0])) == "AB", "UTF-16 little-endian ID3 text")
	check(META._text(PackedByteArray([2, 0, 65, 0, 66, 0, 0])) == "AB", "UTF-16 big-endian ID3 text")
	var comments := u32(0)
	comments.append_array(u32(3))
	for text in ["TITLE=Vorbis title", "ARTIST=Vorbis artist", "ALBUM=Vorbis album"]:
		var bytes: PackedByteArray = text.to_utf8_buffer()
		comments.append_array(u32(bytes.size()))
		comments.append_array(bytes)
	var packet := PackedByteArray([3])
	packet.append_array("vorbis".to_ascii_buffer())
	packet.append_array(comments)
	# A syntactic Ogg page; CRC isn't required by a read-only tag parser.
	var page := "OggS".to_ascii_buffer()
	page.resize(27)
	page[26] = 1
	page.append(packet.size())
	page.append_array(packet)
	write("res://.godot/comment-test.ogg", page)
	result = META.read_track("res://.godot/comment-test.ogg")
	check(result.title == "Vorbis title" and result.artist == "Vorbis artist" and result.album == "Vorbis album", "Ogg Vorbis comment packet")
	var info := "INFO".to_ascii_buffer()
	for pair in [["INAM", "Wave title"], ["IART", "Wave artist"], ["IPRD", "Wave album"]]:
		var bytes: PackedByteArray = pair[1].to_utf8_buffer()
		bytes.append(0)
		info.append_array(pair[0].to_ascii_buffer())
		info.append_array(u32(bytes.size()))
		info.append_array(bytes)
		if bytes.size() & 1: info.append(0)
	var wav := "RIFF".to_ascii_buffer()
	wav.append_array(u32(4 + 8 + 32 * 1024 * 1024 + 8 + info.size()))
	wav.append_array("WAVEdata".to_ascii_buffer())
	wav.append_array(u32(32 * 1024 * 1024))
	var file := FileAccess.open("res://.godot/info-test.wav", FileAccess.WRITE)
	file.store_buffer(wav)
	file.seek(file.get_position() + 32 * 1024 * 1024)
	file.store_buffer("LIST".to_ascii_buffer())
	file.store_buffer(u32(info.size()))
	file.store_buffer(info)
	file.close()
	result = META.read_track("res://.godot/info-test.wav")
	check(result.title == "Wave title" and result.artist == "Wave artist" and result.album == "Wave album", "WAV INFO beyond 32 MB PCM is reached without loading audio")
	check(META.read_track("res://.godot/no-such-file.mp3").title == "no-such-file", "Missing track retains filename fallback")
	print("Failures: ", failures)
	quit(0 if failures == 0 else 1)
